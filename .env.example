# YouTube Data API v3 key (Google Cloud Console -> enable "YouTube Data API v3" -> Create API key)
# Without it the site shows the channel's uploads playlist instead of a most-viewed list.
YOUTUBE_API_KEY=

# Booking emails via Resend (resend.com). Optional: without them bookings are only logged on the server.
RESEND_API_KEY=
BOOKING_TO_EMAIL=you@example.com
BOOKING_FROM_EMAIL=Bookings <onboarding@resend.dev>
